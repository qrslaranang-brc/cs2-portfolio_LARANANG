def calculate_total(price, quantity):
  total = price * quantity
  return total
  
def calculate_change(payment, total):
    change = payment - total
    return change
  
item_price = float(input("Enter the item's price: "))
item_quantity = float(input("Enter the quantity of the item please: "))
amount_paid = float(input("Enter the amount paid by the customer: "))
 
total_cost = calculate_total(item_price, item_quantity)
change_amount = calculate_change(amount_paid, total_cost)
  
print("Total Cost: ₱", total_cost)
 
if change_amount < 0:
      shortage = change_amount * -1
      print("shortage: ₱", shortage)
else: print("Change: ₱", change_amount)
